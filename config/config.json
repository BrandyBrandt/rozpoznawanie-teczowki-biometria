{
  "paths": {
    "input_dir": "../MMU-Iris-Database",
    "output_dir": "results_mmu"
  },
  "preprocessing": {
    "grayscale": true,
    "normalize_histogram": false,
    "gaussian_blur_kernel": 3
  },
  "segmentation": {
    "iris_threshold_divisor_xi": 5.0,
    "pupil_threshold_divisor_xp": 7.0,
    "morph_kernel_size": 3,
    "min_component_area": 150,
    "pupil_hough_min_radius": 20,
    "pupil_hough_max_radius": 110,
    "iris_min_radius_scale": 1.8,
    "iris_max_radius_scale": 4.0,
    "radial_smoothing_window": 9
  },
  "encoding": {
    "gabor_frequency": 0.02454369260617026,
    "radial_bands": 8,
    "angular_samples": 128,
    "response_reliability_threshold": 0.015
  },
  "normalization": {
    "radial_samples_per_band": 16,
    "upper_angle_exclusion_deg": 35.0,
    "lower_angle_exclusion_deg": 20.0
  },
  "matching": {
    "verify_threshold": 0.216,
    "max_angular_shift": 8
  },
  "evaluation": {
    "threshold_steps": 1001
  },
  "runtime": {
    "log_level": "INFO",
    "save_debug_images": true
  }
}
